{
  "name": "maktaba-server",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env dist/index.js",
    "seed": "tsx --env-file-if-exists=../.env src/db/seed-cli.ts",
    "create-admin": "tsx --env-file-if-exists=../.env src/scripts/create-admin.ts",
    "hash-password": "tsx src/scripts/hash-password.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test src/tests/*.test.ts"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "@supabase/supabase-js": "^2.47.10",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true
}
