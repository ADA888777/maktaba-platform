# ========= إعدادات منصة المكتبة الرقمية =========
# انسخي هذا الملف إلى .env للتطوير المحلي، وفي الإنتاج تُوضع القيم في متغيرات بيئة المنصة (Render).
# لا تُرفع أي قيم حقيقية إلى Git.

NODE_ENV=production
PORT=10000

# --- قاعدة البيانات (Supabase / PostgreSQL) ---
# من Supabase: Project Settings > Database > Connection string > Session pooler
# مهم: استخدمي رابط الـ pooler لأن Render لا يدعم IPv6 للاتصال المباشر.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
PG_POOL_MAX=5

# --- تخزين الملفات (Supabase Storage) ---
# SUPABASE_URL: Project Settings > API > Project URL
# SUPABASE_SERVICE_ROLE_KEY: Project Settings > API > service_role (سري جدًا — لا يُستخدم في الواجهة)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads

# --- أسرار الجلسات والإحصائيات (32 حرفًا على الأقل لكل واحد) ---
# لتوليد قيمة: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
ANALYTICS_SALT=

# --- حساب مسؤولة النطام (يُنشأ تلقائيًا عند أول تشغيل) ---
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=مسؤولة النطام
# كلمة مرور قوية (10 أحرف على الأقل مع أرقام). تُجزّأ بـ scrypt عند أول تشغيل ولا تُحفظ كنص.
ADMIN_PASSWORD=
# اجعليها true مرة واحدة فقط لإعادة ضبط كلمة المرور المنسية ثم احذفيها
ADMIN_RESET_PASSWORD=false

# --- الربط مع Power Automate (اختياري — وضع flow فقط) ---
FLOW_URL_BORROW=
FLOW_URL_VISIT=

# --- إعدادات إضافية ---
# في التطوير فقط: تقبل النماذج المرسلة دون إرسالها لجهة خارجية
FORMS_DEV_SINK=false
CLIENT_ORIGIN=http://localhost:5173
# مجلد محلي احتياطي للمرفوعات عند عدم إعداد Supabase Storage
UPLOADS_DIR=./uploads
