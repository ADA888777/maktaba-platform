# ─────────────────────────────────────────────────────────────
#  إعدادات منصة المكتبة — انسخي هذا الملف إلى ".env" ثم عدّلي القيم
#  لا ترفعي ملف .env إلى أي مستودع عام. الملف مُستثنى في .gitignore
# ─────────────────────────────────────────────────────────────

# بيئة التشغيل: development أو production
NODE_ENV=development
PORT=4000

# رابط الواجهة المسموح له بالاتصال بالخادم (CORS) أثناء التطوير
CLIENT_ORIGIN=http://localhost:5173

# مسار ملف قاعدة البيانات (محتوى غير حساس + إحصائيات مجهولة الهوية فقط)
DATABASE_PATH=./data/library.db

# مفتاح توقيع جلسات لوحة التحكم — نص عشوائي طويل (32 حرفًا على الأقل)
# لتوليده: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ملح إخفاء هوية الزوار في الإحصائيات — نص عشوائي مختلف عن السابق
ANALYTICS_SALT=

# ── حساب المسؤولة الأولى ──
# يُنشأ الحساب عند أول تشغيل فقط إذا لم يوجد أي مستخدم.
# ضعي تجزئة كلمة المرور (وليس كلمة المرور نفسها):
#   npm run hash-password --prefix server
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=مسؤولة المكتبة
ADMIN_PASSWORD_HASH=

# ── ربط النماذج عبر Power Automate (اختياري) ──
# روابط HTTP Trigger الخاصة بتدفقات Power Automate في حساب المؤسسة.
# هذه الروابط تحتوي على توقيع سري؛ لذلك تبقى هنا فقط ولا تظهر في الواجهة.
FLOW_URL_BORROW=
FLOW_URL_VISIT=

# وضع التجربة للنماذج: عند تفعيله وعدم وجود رابط تدفق، يتحقق الخادم من
# البيانات ثم يتجاهلها دون تخزين أو إرسال. لا تفعّليه في بيئة الإنتاج.
FORMS_DEV_SINK=true

# تعبئة بيانات تجريبية للإحصائيات عند أول تشغيل (يمكن حذفها من الإعدادات)
SEED_DEMO_ANALYTICS=true

# ملفات تعريف الارتباط الآمنة (تتطلب HTTPS). الافتراضي: مفعّلة في الإنتاج.
# اجعليها false فقط إذا كان الموقع يعمل داخل شبكة المنشأة عبر http مؤقتًا.
# SECURE_COOKIES=true
